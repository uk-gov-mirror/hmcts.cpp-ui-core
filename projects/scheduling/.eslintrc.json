{
  "extends": "../../.eslintrc.json",
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": [
          "projects/scheduling/tsconfig.lib.json",
          "projects/scheduling/tsconfig.spec.json"
        ]
      },
      "rules": {
